CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
# Both families linked; APP_OLED_USE_SH1106 in app_oled.h picks setup at runtime
CONFIG_U8G2_DISPLAY_DRIVER_ALL=y

# HW-466AB: USB-C is chip USB Serial/JTAG — use it for monitor input (not UART0 GPIO20/21).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
