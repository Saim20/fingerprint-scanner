CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Mixed WPA2/WPA3 routers (WPA2-only threshold fails on WPA3-only APs)
CONFIG_ESP_WIFI_AUTH_WPA2_PSK=n
CONFIG_ESP_WIFI_AUTH_WPA2_WPA3_PSK=y
CONFIG_ESP_MAXIMUM_RETRY=10
# Both families linked; APP_OLED_USE_SH1106 in app_oled.h picks setup at runtime
CONFIG_U8G2_DISPLAY_DRIVER_ALL=y

# HW-466AB: USB-C is chip USB Serial/JTAG — use it for monitor input (not UART0 GPIO20/21).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Supabase cloud (override in menuconfig or NVS cloudurl / provision)
CONFIG_CLOUD_SUPABASE_URL=""
CONFIG_CLOUD_DEVICE_API_KEY=""

# TLS for *.supabase.co (Google Trust Services cross-signed chain)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
